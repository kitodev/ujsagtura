{
  "expo": {
    "name": "Újságtúra",
    "slug": "ujsagtura",
    "scheme": "ujsagtura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hu.ujsagtura.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "A navigációhoz és a következő cím távolságához kell a helyzeted."
      }
    },
    "android": {
      "package": "hu.ujsagtura.app",
      "adaptiveIcon": {
        "backgroundColor": "#1f4e79",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A navigációhoz és a következő cím távolságához kell a helyzeted."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "79f84ce9-1b01-42f5-a5e7-69d6f3020a84"
      }
    }
  }
}
